{
  "name": "create-kumooo",
  "version": "0.3.0",
  "description": "Create a kumooo.js app (blank, blog, or shop)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-kumooo": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renzoreyn/kumooo.git",
    "directory": "packages/create-kumooo"
  },
  "homepage": "https://kumooo.dev",
  "keywords": [
    "kumooo",
    "nextjs",
    "create",
    "scaffold",
    "cloudflare"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ./scripts/sync-templates.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "echo \"ok\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
